  m_Script: {fileID: 11500000, guid: 1ea2e17cf3127634d9f2fb99cfb23977, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PipInteraction
  pipName: Pip
  pipPortrait: {fileID: -1317407216, guid: 2756c0eb56219d040bc307504f8da482, type: 3}
  promptCanvas: {fileID: 936896397}
  fadeSpeed: 5
  interactionDistance: 3
  player: {fileID: 0}
  finaleFountainTarget: {fileID: 260821773}
  pipInstructionsLines:
  - We are here, Sound Keeper! The fountain sits at the absolute heart of Word Valley.
  - All five Vowel Stones are glowing in your wand. But to break Miss Spell's curse
    completely, you must recite the Ancient Valley Sound Chant.
  - Come talk to me again whenever you're ready.
--- !u!114 &1364002866
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1364002864}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5319a4572259014db9a16b49f655344, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PipHint
  fountainIntroDialogue:
  - Look to my right!
  - Miss Spell has taken over the Archmage's Hall!
  - Quickly! Let's go to the <i>Police Station</i>, where Sheriff Sans is waiting.
    Hoo-hoo!
  pip: {fileID: 1364002868}
  objectives:
  - houseLetter: A
    hoverLocation: {fileID: 788025155}
    dialogueHints:
    - Ready when you are, Sound Keeper. Talk to <i>Sheriff Sans</i> to begin.
    completionDialogue: Wonderful! One stone awake, four to go. Next is the <i>Judge
      Hall</i>, Judge Mental is waiting at the courtroom!
  - houseLetter: E
    hoverLocation: {fileID: 465167193}
    dialogueHints:
    - Ready when you are, Sound Keeper. Talk to <i>Judge Mental</i> to begin.
    completionDialogue: Two stones awake! Now to the <i>Playground</i> where Penny
      Cil is waiting.
  - houseLetter: I
    hoverLocation: {fileID: 2093842313}
    dialogueHints:
    - Ready when you are, Sound Keeper. Talk to <i>Penny Cil</i> to begin.
    completionDialogue: Three stones! You're more than halfway. Off to <i>Grandma
      Phonic's Home</i>!
  - houseLetter: O
    hoverLocation: {fileID: 1738288982}
    dialogueHints:
    - Ready when you are, Sound Keeper. Talk to <i>Grandma Phonics</i> to begin.
    completionDialogue: Four stones awake! Only one remains. The <i>library</i> and
      Connie Sonant is waiting for you there.
  - houseLetter: U
    hoverLocation: {fileID: 1617986958}
    dialogueHints:
    - Ready when you are, Sound Keeper. Talk to <i>Connie Sonant</i> to begin.
    completionDialogue: You did it! All five Vowel Stones are alive! Now hurry, Sound
      Keeper. Meet me at the <i>Fountain</i> for the final step!
