--- !u!114 &2927296298811742203
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3253472982184902196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 6
  fadeSpeed: 5
  promptCanvas: {fileID: 1130515549444962875}
  player: {fileID: 0}
  isInPuzzleHouse: 0
  npcName: Connie Sonant
  npcPortrait: {fileID: -123101456, guid: b85b800ecebde754db75b29fdfcd3b76, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: Shhh... oh! Forgive me. Welcome to the library. I am Connie Sonant, keeper
      of every book in Word Valley.
  - speaker: 0
    text: A library should be calm and quiet... but the mush-mush curse turned mine
      upside down!
  - speaker: 0
    text: Now the words mumble and mutter on their own. I can't tell which vowels
      they're saying A? E? I? O? U? It's all a jumble!
  - speaker: 0
    text: If you truly are the Sound Keeper, your sharp ears are exactly what I need.
      Will you help me quiet the books?
  - speaker: 1
    text: "I\u2019ll do that!"
  dialogueLinesAfterSolved:
  - speaker: 1
    text: What to do now?
  - speaker: 0
    text: Talk to Pip on where to next.
  dialogueCamera: {fileID: 5081088987685677972}
  sceneToLoad: HouseU
  associatedHouse: 4
  autoPlayWhenSolved: 0
  autoPlayDelay: 1.5
