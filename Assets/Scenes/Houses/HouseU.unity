  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 3
  fadeSpeed: 5
  promptCanvas: {fileID: 1513837401}
  player: {fileID: 0}
  npcName: Connie Sonant
  npcPortrait: {fileID: -123101456, guid: b85b800ecebde754db75b29fdfcd3b76, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: 'Here is the task: I''ll play a mumbled word for you to hear.'
  - speaker: 0
    text: 'Here is the task: I''ll play a mumbled word for you to hear.'
  - speaker: 0
    text: "Listen closely for the *vowel* sound hiding inside. Then use your wand
      to choose the right vowel \u2014 A, E, I, O, or U."
  - speaker: 0
    text: There are three words to settle. Each one needs its right vowel to find
      peace.
  dialogueLinesAfterSolved:
  - speaker: 0
    text: Peace at last... the books are quiet again. Thank you, Sound Keeper. You
      have a wonderful ear.
  - speaker: 0
    text: Peace at last... the books are quiet again. Thank you, Sound Keeper. You
      have a wonderful ear.
  - speaker: 0
    text: All five vowels are awake now. The valley owes you a great debt.
  - speaker: 1
    text: You're welcome Connie Sonant!
  dialogueCamera: {fileID: 977020707}
  sceneToLoad: 
  associatedHouse: 4
  autoPlayWhenSolved: 1
  autoPlayDelay: 1.5
  houseLetter: U
