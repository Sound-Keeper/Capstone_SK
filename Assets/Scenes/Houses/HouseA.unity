MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1155355564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 5
  fadeSpeed: 5
  promptCanvas: {fileID: 1061325197}
  player: {fileID: 0}
  isInPuzzleHouse: 1
  npcName: 'Sheriff Sans:'
  npcPortrait: {fileID: -1826037531, guid: 9249fd80ca4c11a4d8910ad8a36da092, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: 'Here''s the deal: each broken piece is part of a letter. Use your wand
      to pick up a piece and set it in the right spot.'
  - speaker: 0
    text: When all the letters are fixed, they'll spell out the magic word and our
      Vowel Stone will wake right up!
  - speaker: 0
    text: Take your time, partner. Look at the shapes real careful. That's the whole
      secret.
  - speaker: 1
    text: Got it!
  dialogueLinesAfterSolved:
  - speaker: 0
    text: Well, I'll be! You did it! Look at 'em good as new!
  - speaker: 0
    text: On behalf of all of House A, thank you kindly, Sound Keeper. Miss Spell's
      magic just got a whole lot weaker.
  - speaker: 1
    text: You're welcome Sheriff Sans!
  dialogueCamera: {fileID: 977020707}
  sceneToLoad: 
  associatedHouse: 0
  autoPlayWhenSolved: 1
  autoPlayDelay: 1.5
