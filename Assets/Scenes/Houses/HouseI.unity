    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueCamera
      value: 
      objectReference: {fileID: 376465911}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: isInPuzzleHouse
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: interactionRange
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: autoPlayWhenSolved
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: 'Here''s my puzzle: the curse scattered all the letters around the playground.'
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: Walk around and find them! Use your wand to pick up each letter.
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLines.Array.data[2].text
      value: Then place the letters in the right order on the stones to spell the
        word. We can do it one letter at a time!
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLines.Array.data[3].text
      value: Got it!
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLines.Array.data[3].speaker
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLinesAfterSolved.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLinesAfterSolved.Array.data[0].text
      value: I... I remember now! That's it! That's the word!
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLinesAfterSolved.Array.data[1].text
      value: You helped me believe in myself again.
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLinesAfterSolved.Array.data[2].text
      value: Thank you, Sound Keeper! See? When we don't give up, we *can* do it!
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLinesAfterSolved.Array.data[3].text
      value: You're welcome Penny Cil!
      objectReference: {fileID: 0}
    - target: {fileID: 6788318501258618676, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: dialogueLinesAfterSolved.Array.data[3].speaker
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7817698224428091723, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: 'm_Materials.Array.data[0]'
      value: 
      objectReference: {fileID: 2100000, guid: 556645bad9f687f408b9ce5463455bb1, type: 2}
    - target: {fileID: 8610591586353588382, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: m_Name
      value: Penny Cil Mesh
      objectReference: {fileID: 0}
    - target: {fileID: 8882503290214517979, guid: 37a1313028abde14e9e7557bd93148ef, type: 3}
      propertyPath: detectionRadius
      value: 3
