MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2026762496}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 3
  fadeSpeed: 5
  promptCanvas: {fileID: 1781908068}
  player: {fileID: 0}
  npcName: Penny Cil
  npcPortrait: {fileID: 888456920, guid: 807ce45ede365ae4c9e4339bd306e224, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: 'Here''s my puzzle: the curse scattered all the letters around the playground.'
  - speaker: 0
    text: Walk around and find them! Use your wand to pick up each letter.
  - speaker: 0
    text: "Then place the letters in the right order on the stones to spell the word.
      We can do it \u2014 one letter at a time!"
  - speaker: 1
    text: Got it!
  dialogueLinesAfterSolved:
  - speaker: 0
    text: I... I remember now! That's it! That's the word!
  - speaker: 0
    text: You helped me believe in myself again.
  - speaker: 0
    text: Thank you, Sound Keeper! See? When we don't give up, we *can* do it!
  - speaker: 1
    text: You're welcome Penny Cil!
  dialogueCamera: {fileID: 376465911}
  sceneToLoad: 
  associatedHouse: 2
  autoPlayWhenSolved: 1
  autoPlayDelay: 1.5
  houseLetter: I
