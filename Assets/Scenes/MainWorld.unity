  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5319a4572259014db9a16b49f655344, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PipHint
  fountainIntroDialogue:
  - "Let's begin with <b>House A</b>, where Sheriff Sans is waiting. Visit the houses
    in order \u2014 A, E, I, O, U. I'll be right beside you the whole way. Hoo-hoo!"
  pip: {fileID: 729739154}
  objectives:
  - houseLetter: A
    hoverLocation: {fileID: 164023087}
    dialogueHints:
    - This is <b>House A</b>
    completionDialogue: "Wonderful! One stone awake, four to go. Next is <b>House
      E</b> \u2014 Judge Mental is waiting at the courtroom!"
  - houseLetter: E
    hoverLocation: {fileID: 758178361}
    dialogueHints:
    - This is <b>House E</b>
    completionDialogue: "Two stones awake! Now to <b>House I</b> \u2014 Penny Cil
      is over at the playground."
  - houseLetter: I
    hoverLocation: {fileID: 1956384379}
    dialogueHints:
    - This is <b>House I</b>
    completionDialogue: "Three stones! You're more than halfway. Off to <b>House
      O</b> \u2014 Grandma Phonic loves visitors!"
  - houseLetter: O
    hoverLocation: {fileID: 1619825118}
    dialogueHints:
    - This is <b>House O</b>
    completionDialogue: "Four stones awake! Only one remains. The library \u2014
      and Connie Sonant \u2014 wait for you in <b>House U</b>."
  - houseLetter: U
    hoverLocation: {fileID: 547393103}
    dialogueHints:
    - This is <b>House U</b>
    completionDialogue: "You did it! All five Vowel Stones are alive! Now hurry,
      Sound Keeper \u2014 meet me at the <b>Town Hall</b> for the final step!"
