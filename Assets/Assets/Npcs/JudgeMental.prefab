--- !u!114 &5542818172259522140
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1705843687668289820}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 5
  fadeSpeed: 5
  promptCanvas: {fileID: 2252556017908715531}
  player: {fileID: 0}
  npcName: 'Judge Mental:'
  npcPortrait: {fileID: -786107253, guid: bc12c717c02c6ee45af890f36517b7ec, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: Order! Order in the court! Ah... a visitor. State your name, young mage.
  - speaker: 1
    text: Hello, I'm {player}.
  - speaker: 0
    text: I am Judge Mental, keeper of the rules of Word Valley. I make sure every
      sentence stands fair and true.
  - speaker: 0
    text: But the mush-mush curse has thrown my courtroom into chaos! The words in
      my most important book have all jumbled up.
  - speaker: 0
    text: My own sentences no longer make sense. A judge who cannot read his own
      rules... how embarrassing!
  - speaker: 0
    text: You are the Sound Keeper? Splendid. I call upon you to help me set my sentences
      right.
  - speaker: 1
    text: I got it!
  dialogueLinesAfterSolved:
  - speaker: 0
    text: Talk to Pip on where to next.
  dialogueCamera: {fileID: 0}
  sceneToLoad: HouseE
  associatedHouse: 1
  autoPlayWhenSolved: 0
  autoPlayDelay: 1.5
  houseLetter: E
