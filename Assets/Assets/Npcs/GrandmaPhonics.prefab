  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 5
  fadeSpeed: 5
  promptCanvas: {fileID: 4167609044942907205}
  player: {fileID: 0}
  npcName: 'Grandma Phonics:'
  npcPortrait: {fileID: 140222843, guid: 275c3be968beaad46a08473704a543b7, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: Oh my, a young visitor! Come in, come in, dearie. I'm Grandma Phonic. I
      do love my music.
  - speaker: 0
    text: Every morning I sing with the birds and hum my favorite tunes. Music keeps
      Word Valley's heart beating.
  - speaker: 0
    text: But that nasty mush-mush curse muddled up all my songs! The words don't
      rhyme anymore, and the melodies sound all wrong.
  - speaker: 0
    text: You're the Sound Keeper? Oh, how lovely. Would you help an old lady fix
      her songs, dearie?
  - speaker: 1
    text: Let me try!
  dialogueLinesAfterSolved:
  - speaker: 0
    text: Talk to Pip on where to next.
  dialogueCamera: {fileID: 0}
  sceneToLoad: HouseO
  associatedHouse: 3
  autoPlayWhenSolved: 0
  autoPlayDelay: 1.5
  houseLetter: O
