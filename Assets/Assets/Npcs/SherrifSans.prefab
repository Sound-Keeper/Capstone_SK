  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 5
  fadeSpeed: 5
  promptCanvas: {fileID: 1158976403516616356}
  player: {fileID: 0}
  npcName: 'Sheriff Sans:'
  npcPortrait: {fileID: -1826037531, guid: 9249fd80ca4c11a4d8910ad8a36da092, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: "Well, howdy there, partner! Sheriff Sans is the name \u2014 I keep the
      peace here in House A."
  - speaker: 0
    text: But today... whew. When the mush-mush curse hit, our townsfolk got shattered
      into pieces!
  - speaker: 0
    text: "Look at 'em \u2014 bits of letters scattered all over. They can't even
      stand up straight."
  - speaker: 0
    text: I hear you're the Sound Keeper. Think you can lend a hand and put our folks
      back together?
  - speaker: 1
    text: Sure! Let's do it.
  dialogueLinesAfterSolved:
  - speaker: 0
    text: Talk to Pip on where to next.
  dialogueCamera: {fileID: 0}
  sceneToLoad: HouseA
  associatedHouse: 0
  autoPlayWhenSolved: 0
  autoPlayDelay: 1.5
  houseLetter: A
