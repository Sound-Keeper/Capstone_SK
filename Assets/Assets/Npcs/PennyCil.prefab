  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a35bdfa08263d2f4faeea8f3559d750d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcInteraction
  interactionRange: 5
  fadeSpeed: 5
  promptCanvas: {fileID: 2381952772662390411}
  player: {fileID: 0}
  npcName: 'Penny Cil:'
  npcPortrait: {fileID: 888456920, guid: 807ce45ede365ae4c9e4339bd306e224, type: 3}
  playerPortrait: {fileID: 0}
  dialogueLines:
  - speaker: 0
    text: Oh! H-hello there! I'm Penny Cil. I'm a pencil, see? Writing words is the
      one thing I'm good at...
  - speaker: 0
    text: Or... I *used* to be. Ever since the mush-mush curse, I forgot how to spell!
      Even easy words just slip right away.
  - speaker: 0
    text: Or... I *used* to be. Ever since the mush-mush curse, I forgot how to spell!
      Even easy words just slip right away.
  - speaker: 0
    text: It makes me so sad. I get scared I'll get it wrong, so sometimes I just...
      stop trying.
  - speaker: 0
    text: "Wait \u2014 are you the Sound Keeper? Maybe... maybe if we work together,
      I can remember again?"
  - speaker: 1
    text: "Let\u2019s give it a try!"
  dialogueLinesAfterSolved:
  - speaker: 0
    text: Talk to Pip on where to next.
  dialogueCamera: {fileID: 0}
  sceneToLoad: HouseI
  associatedHouse: 2
  autoPlayWhenSolved: 0
  autoPlayDelay: 1.5
  houseLetter: I
